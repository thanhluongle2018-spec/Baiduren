// 摆渡人 data model — phase 1
// Speed tests are written by a future Worker / Agent, not by the frontend.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ContentStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SpeedTestStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SpeedTestMode {
  SINGLE_THREAD
  MULTI_THREAD
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   Review[]

  @@index([role])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  airports    Airport[]
}

model Airport {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  summary     String
  description String?
  logoUrl     String?
  websiteUrl  String?
  status      ContentStatus @default(DRAFT)
  score       Decimal?      @db.Decimal(4, 2)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  plans      AirportPlan[]
  nodes      Node[]
  speedTests SpeedTest[]
  reviews    Review[]
  promotions Promotion[]

  @@index([status, score])
  @@index([categoryId])
}

model AirportPlan {
  id           String        @id @default(cuid())
  airportId    String
  airport      Airport       @relation(fields: [airportId], references: [id], onDelete: Cascade)
  name         String
  price        Decimal       @db.Decimal(10, 2)
  currency     String        @default("CNY")
  billingCycle String
  trafficGb    Int?
  deviceLimit  Int?
  features     String[]
  status       ContentStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([airportId, status])
}

model Node {
  id         String        @id @default(cuid())
  airportId  String
  airport    Airport       @relation(fields: [airportId], references: [id], onDelete: Cascade)
  name       String
  region     String
  kind       String
  status     ContentStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  speedTests SpeedTest[]

  @@index([airportId, region])
}

/// Future independent speed-test servers / agents. Not used in phase 1.
model SpeedTestServer {
  id         String        @id @default(cuid())
  name       String
  region     String
  endpoint   String?
  status     ContentStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  speedTests SpeedTest[]

  @@index([region, status])
}

/// A speed-test job. Created by the worker pipeline, not by page requests.
model SpeedTest {
  id           String           @id @default(cuid())
  airportId    String
  airport      Airport          @relation(fields: [airportId], references: [id], onDelete: Cascade)
  nodeId       String?
  node         Node?            @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  serverId     String?
  server       SpeedTestServer? @relation(fields: [serverId], references: [id], onDelete: SetNull)
  status       SpeedTestStatus  @default(PENDING)
  mode         SpeedTestMode    @default(SINGLE_THREAD)
  region       String
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  result       SpeedTestResult?

  @@index([airportId, createdAt])
  @@index([status, createdAt])
  @@index([nodeId])
  @@index([serverId])
}

model SpeedTestResult {
  id           String    @id @default(cuid())
  speedTestId  String    @unique
  speedTest    SpeedTest @relation(fields: [speedTestId], references: [id], onDelete: Cascade)
  latencyMs    Decimal?  @db.Decimal(8, 2)
  downloadMbps Decimal?  @db.Decimal(10, 2)
  uploadMbps   Decimal?  @db.Decimal(10, 2)
  packetLoss   Decimal?  @db.Decimal(5, 2)
  successRate  Decimal?  @db.Decimal(5, 2)
  stability    Decimal?  @db.Decimal(5, 2)
  testedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
}

model Review {
  id        String       @id @default(cuid())
  airportId String
  airport   Airport      @relation(fields: [airportId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating    Int
  title     String?
  content   String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([airportId, status, createdAt])
  @@index([userId])
}

model Promotion {
  id           String           @id @default(cuid())
  airportId    String
  airport      Airport          @relation(fields: [airportId], references: [id], onDelete: Cascade)
  name         String
  affiliateUrl String
  couponCode   String?
  status       ContentStatus    @default(DRAFT)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  clicks       PromotionClick[]

  @@index([airportId, status])
}

model PromotionClick {
  id          String     @id @default(cuid())
  promotionId String
  promotion   Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  source      String?
  referrer    String?
  createdAt   DateTime   @default(now())

  @@index([promotionId, createdAt])
  @@index([createdAt])
}

model Announcement {
  id          String        @id @default(cuid())
  title       String
  content     String
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}
