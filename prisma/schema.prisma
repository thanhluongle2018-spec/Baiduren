// 摆渡人 data model — phase 3B-3 raw metrics schema.
// Real node probing, proxy connections, and public scans remain out of scope.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ContentStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SpeedTestServerStatus {
  ACTIVE
  DISABLED
}

enum SpeedTestStatus {
  PENDING
  QUEUED
  RUNNING
  /// Current success terminal used by the Worker.
  SUCCESS
  /// Legacy success terminal from earlier phases. Ranking still treats it as valid.
  COMPLETED
  FAILED
  CANCELLED
}

enum SpeedTestMode {
  SINGLE_THREAD
  MULTI_THREAD
}

/// Stage of a speed test run. Null on legacy rows means the stage is unknown.
enum SpeedTestStage {
  LATENCY
  PACKET_LOSS
  SINGLE_DOWNLOAD
  MULTI_DOWNLOAD
  SINGLE_UPLOAD
  MULTI_UPLOAD
  COMPLETE
}

/// Per-transfer outcome. Distinct from SpeedTestStatus (job lifecycle).
enum SpeedTestStageStatus {
  SUCCESS
  PARTIAL
  TIMEOUT
  FAILED
  SKIPPED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   Review[]

  @@index([role])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  airports    Airport[]
}

model Airport {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  summary     String
  description String?
  logoUrl     String?
  websiteUrl  String?
  status      ContentStatus @default(DRAFT)
  /// Stored reference score only. Composite ranking algorithm is not locked in this phase.
  score       Decimal?      @db.Decimal(4, 2)
  isDemo      Boolean       @default(false)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  plans      AirportPlan[]
  nodes      Node[]
  speedTests SpeedTest[]
  reviews    Review[]
  promotions Promotion[]

  @@index([status, score])
  @@index([categoryId])
  @@index([isDemo, status])
}

/// Plan table. billingCycle maps to billingPeriod; trafficGb maps to traffic.
model AirportPlan {
  id           String        @id @default(cuid())
  airportId    String
  airport      Airport       @relation(fields: [airportId], references: [id], onDelete: Cascade)
  name         String
  price        Decimal       @db.Decimal(10, 2)
  currency     String        @default("CNY")
  billingCycle String
  trafficGb    Int?
  description  String?
  deviceLimit  Int?
  features     String[]
  status       ContentStatus @default(ACTIVE)
  isDemo       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([airportId, status])
}

model Node {
  id         String        @id @default(cuid())
  airportId  String
  airport    Airport       @relation(fields: [airportId], references: [id], onDelete: Cascade)
  name       String
  region     String
  kind       String
  status     ContentStatus @default(ACTIVE)
  isDemo     Boolean       @default(false)
  /// Clash/Mihomo protocol after normalization. Null for legacy demo rows.
  protocol   String?
  server     String?
  port       Int?
  /// Name-inferred region code. Not a real IP geolocation.
  regionHint String?
  sourceFormat String?
  /// sha256 identity. Unique per airport when present. Never stores raw secrets.
  fingerprint String?
  /// Original proxy config for a future runtime. Never expose via public APIs.
  rawConfig   String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  speedTests SpeedTest[]

  @@index([airportId, region])
  @@index([airportId, status])
  @@unique([airportId, fingerprint])
}

/// Independent speed-test servers / agents. Demo identifiers only — no real IPs.
model SpeedTestServer {
  id                 String                 @id @default(cuid())
  name               String
  region             String
  countryCode        String
  city               String
  bandwidthMbps      Int
  maxConcurrentTests Int                    @default(1)
  /// Optional future callback URL. Never store a real probe target here in this phase.
  endpoint           String?
  status             SpeedTestServerStatus  @default(DISABLED)
  isDemo             Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  speedTests         SpeedTest[]

  @@index([region, status])
  @@index([status])
}

/// A speed-test job. Created via createSpeedTestJob(); executed by the Worker.
model SpeedTest {
  id           String            @id @default(cuid())
  airportId    String
  airport      Airport           @relation(fields: [airportId], references: [id], onDelete: Cascade)
  nodeId       String?
  node         Node?             @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  /// Product field speedTestServerId.
  serverId     String?
  server       SpeedTestServer?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  status       SpeedTestStatus   @default(PENDING)
  mode         SpeedTestMode     @default(SINGLE_THREAD)
  /// Simulated thread count. Valid range is 1–8.
  concurrency  Int               @default(1)
  region       String
  startedAt    DateTime?
  /// Completion time. Maps to the product field completedAt.
  finishedAt   DateTime?
  errorMessage String?
  /// Worker lease deadline. Expired RUNNING jobs are failed by the reaper.
  leaseExpiresAt DateTime?
  /// Last successful lease heartbeat from the owning Worker.
  heartbeatAt    DateTime?
  /// Engine error code. Null on legacy rows. Never store secrets here.
  errorCode    String?
  /// Future protocol version, e.g. 3b3-v1. Not a database default.
  testVersion  String?
  /// Last observed stage. Null on legacy rows; not the same as 0 Mbps.
  currentStage SpeedTestStage?
  latencyAttempts          Int?
  pingTimeoutMs            Int?
  downloadConcurrency      Int?
  uploadConcurrency        Int?
  singleDownloadCapBytes   Int?
  multiDownloadCapBytes    Int?
  singleUploadCapBytes     Int?
  multiUploadCapBytes      Int?
  totalTrafficCapBytes     Int?
  /// Snapshots of capacity at test time. Null when the source model has no value.
  serverMaxConcurrencySnapshot Int?
  serverBandwidthMbpsSnapshot  Int?
  /// No Node/Airport concurrency field exists yet; left nullable on purpose.
  nodeConcurrencySnapshot      Int?
  airportConcurrencySnapshot   Int?
  isDemo       Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  result       SpeedTestResult?

  @@index([airportId, createdAt])
  @@index([status, createdAt])
  @@index([nodeId])
  @@index([serverId])
  @@index([serverId, status])
  @@index([status, leaseExpiresAt])
}

model SpeedTestResult {
  id                   String    @id @default(cuid())
  speedTestId          String    @unique
  speedTest            SpeedTest @relation(fields: [speedTestId], references: [id], onDelete: Cascade)
  /// Legacy headline latency. Future real runs may dual-write P50 here.
  latencyMs            Decimal?  @db.Decimal(8, 2)
  minLatencyMs         Decimal?  @db.Decimal(8, 2)
  maxLatencyMs         Decimal?  @db.Decimal(8, 2)
  latencyAvgMs         Decimal?  @db.Decimal(12, 6)
  latencyP50Ms         Decimal?  @db.Decimal(12, 6)
  latencyP90Ms         Decimal?  @db.Decimal(12, 6)
  latencyAttempts      Int?
  latencySuccessCount  Int?
  /// Legacy combined download. New writes also populate downloadSingle/Multi.
  downloadMbps         Decimal?  @db.Decimal(10, 2)
  downloadSingleMbps   Decimal?  @db.Decimal(10, 2)
  downloadMultiMbps    Decimal?  @db.Decimal(10, 2)
  /// Legacy combined upload. New writes also populate uploadSingle/Multi.
  uploadMbps           Decimal?  @db.Decimal(10, 2)
  uploadSingleMbps     Decimal?  @db.Decimal(10, 2)
  uploadMultiMbps      Decimal?  @db.Decimal(10, 2)
  /// Legacy packet loss. New writes also populate packetLossPercent.
  packetLoss           Decimal?  @db.Decimal(5, 2)
  packetLossPercent    Decimal?  @db.Decimal(5, 2)
  packetLossTotal      Int?
  packetLossSuccess    Int?
  /// Legacy success rate. New writes also populate successRatePercent.
  /// successRate* is ping-only; do not mix download/upload into it.
  successRate          Decimal?  @db.Decimal(5, 2)
  successRatePercent   Decimal?  @db.Decimal(5, 2)
  successRateTotal     Int?
  successRateSuccess   Int?
  /// Phase 4 owns stability. Do not auto-fill 0 or derive it in 3B-3.
  stability            Decimal?  @db.Decimal(5, 2)
  singleDownloadBytes      Int?
  singleDownloadDurationMs Int?
  singleDownloadStatus     SpeedTestStageStatus?
  multiDownloadBytes       Int?
  multiDownloadDurationMs  Int?
  multiDownloadConcurrency Int?
  multiDownloadStatus      SpeedTestStageStatus?
  singleUploadBytes        Int?
  singleUploadDurationMs   Int?
  singleUploadStatus       SpeedTestStageStatus?
  multiUploadBytes         Int?
  multiUploadDurationMs    Int?
  multiUploadConcurrency   Int?
  multiUploadStatus        SpeedTestStageStatus?
  /// JSON string array of SpeedTestStage. Null = unknown (legacy). Never store secrets.
  skippedStages        Json?
  errorCode            String?
  errorMessage         String?
  /// True only after a future real Runtime + Mihomo + SpeedTestServer proof.
  /// Fake fixtures must remain isDemo=true even if this is set in tests.
  exitVerified         Boolean?
  /// sha256 identity hashes. Internal only — public mappers/APIs must omit them.
  directIdentityHash   String?
  proxiedIdentityHash  String?
  singleThread         Boolean   @default(false)
  /// Measurement timestamp. Maps to the product field measuredAt.
  testedAt             DateTime  @default(now())
  isDemo               Boolean   @default(false)
  createdAt            DateTime  @default(now())

  @@index([testedAt])
}

model Review {
  id        String       @id @default(cuid())
  airportId String
  airport   Airport      @relation(fields: [airportId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Integer 1–5.
  rating    Int
  title     String?
  content   String
  status    ReviewStatus @default(PENDING)
  isDemo    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([airportId, status, createdAt])
  @@index([userId])
}

model Promotion {
  id           String           @id @default(cuid())
  airportId    String
  airport      Airport          @relation(fields: [airportId], references: [id], onDelete: Cascade)
  name         String
  affiliateUrl String
  couponCode   String?
  clickCount   Int              @default(0)
  enabled      Boolean          @default(false)
  status       ContentStatus    @default(DRAFT)
  isDemo       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  clicks       PromotionClick[]

  @@index([airportId, status])
  @@index([enabled])
}

model PromotionClick {
  id          String     @id @default(cuid())
  promotionId String
  promotion   Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  source      String?
  referrer    String?
  createdAt   DateTime   @default(now())

  @@index([promotionId, createdAt])
  @@index([createdAt])
}

model Announcement {
  id          String        @id @default(cuid())
  title       String
  content     String
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  isDemo      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}
